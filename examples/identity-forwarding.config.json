{
  "servers": {
    "files": {
      "transport": "http",
      "url": "http://localhost:8011/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": { "x-user-identity": "x-delegate-files" }
    },
    "tickets": {
      "transport": "http",
      "url": "http://localhost:8012/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": { "x-user-identity": "x-delegate-tickets" }
    },
    "billing": {
      "transport": "http",
      "url": "http://localhost:8013/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": { "x-user-identity": "x-delegate-billing" }
    }
  },
  "listen": { "mode": "http", "host": "127.0.0.1", "port": 3000, "path": "/mcp" },
  "audit": {
    "enabled": true,
    "includeArgs": "redacted",
    "tamperEvident": true,
    "sinks": [{ "type": "file", "path": "./bastion-audit.jsonl" }]
  }
}
