{
  "servers": {
    "files": {
      "transport": "http",
      "url": "http://localhost:8011/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": {
        "x-user-identity": "x-delegate-files"
      },
      "delegation": {
        "audience": "files",
        "maxLifetimeSeconds": 120,
        "allowedActors": ["orchestrator-agent"],
        "maxChainDepth": 2
      }
    },
    "tickets": {
      "transport": "http",
      "url": "http://localhost:8012/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": {
        "x-user-identity": "x-delegate-tickets"
      },
      "delegation": {
        "audience": "tickets",
        "maxLifetimeSeconds": 120,
        "allowedActors": ["orchestrator-agent"],
        "maxChainDepth": 2
      }
    },
    "billing": {
      "_comment": "Signature mode: Bastion verifies this sub-agent's delegate tokens against the issuer's public keys (still keyless). Needs ES256/EdDSA tokens; HS256 tokens can only be checked structurally, as files and tickets are. Use \"jwks\": { \"keys\": [...] } instead of jwksUrl to pin the public keys inline.",
      "transport": "http",
      "url": "http://localhost:8013/mcp",
      "protocol": "legacy",
      "connect": "onDemand",
      "forwardHeaders": {
        "x-user-identity": "x-delegate-billing"
      },
      "delegation": {
        "audience": "billing",
        "verify": "signature",
        "issuer": "https://spire.example/identity",
        "algorithms": ["ES256", "EdDSA"],
        "jwksUrl": "https://spire.example/.well-known/jwks.json",
        "maxLifetimeSeconds": 120,
        "allowedActors": ["orchestrator-agent"],
        "maxChainDepth": 2
      }
    }
  },
  "delegation": {
    "gatewayAudiences": ["mcp-bastion"],
    "oneUserPerRequest": true,
    "recordSubject": "hash"
  },
  "listen": {
    "mode": "http",
    "host": "127.0.0.1",
    "port": 3000,
    "path": "/mcp"
  },
  "audit": {
    "enabled": true,
    "includeArgs": "redacted",
    "tamperEvident": true,
    "sinks": [
      {
        "type": "file",
        "path": "./bastion-audit.jsonl"
      }
    ]
  }
}
